{
  "name": "up-remastered",
  "version": "1.0.0",
  "private": true,
  "description": "Small self-hosted temporary file hosting service.",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "brand:icons": "node scripts/generate-brand-icons.mjs",
    "dev": "next dev",
    "build": "next build && node scripts/copy-standalone-assets.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "cleanup:expired": "node scripts/cleanup-expired-files.mjs",
    "start": "next start",
    "preview": "pnpm run build && pnpm run start",
    "check": "pnpm run format:check && pnpm run check:no-jvm && pnpm run check:docs && pnpm run check:parity && pnpm run lint && pnpm run typecheck && pnpm run test:unit:ci",
    "check:docs": "node scripts/verify-doc-links.mjs",
    "check:parity": "node scripts/verify-parity-matrix.mjs",
    "check:full": "pnpm run check && pnpm run build && pnpm run test:e2e:ci",
    "check:no-jvm": "node scripts/verify-no-jvm.mjs",
    "format:check": "prettier --check README.md docs package.json docker-compose.yml scripts src",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "eslint . --fix",
    "test": "pnpm run test:unit",
    "test:unit": "jest && pnpm run test:cleanup",
    "test:unit:ci": "jest --ci && pnpm run test:cleanup",
    "test:cleanup": "node --test scripts/cleanup-expired-files.test.mjs",
    "test:unit:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:lighthouse": "playwright test src/app/lighthouse.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.14 <25",
    "pnpm": ">=11"
  },
  "keywords": [
    "file-sharing",
    "self-hosted",
    "nextjs"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "better-sqlite3": "^13.0.3",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.48.0",
    "next": "^16.3.8",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@jest/globals": "30.4.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.4",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^25.8.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.2",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "lighthouse": "^13.3.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
